# Optional collaboration. Omit all three to keep the desktop fully local.
# Main-process environment only; never prefix these with NEXT_PUBLIC_.
SIGMA_COLLABORATION_URL=https://collaboration.example.com
SIGMA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Only a publishable / anon key. Never put a service-role or secret key here.
SIGMA_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

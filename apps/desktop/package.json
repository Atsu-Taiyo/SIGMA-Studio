{
  "name": "@sigma-studio/desktop",
  "version": "0.540.0",
  "description": "数式と図形を扱う教材エディタ / A teaching-material editor for mathematics and diagrams",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ../../scripts/audit-private-conversion.mjs --build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "test:e2e:export": "node scripts/serve-static-export.mjs",
    "perf:build": "node scripts/perf-build.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "perf:probe:noBuild": "node scripts/perf-probe.mjs --no-build",
    "perf:probe:reportOnly": "node scripts/perf-probe.mjs --report-only",
    "csp:smoke": "electron scripts/electron-csp-smoke.mjs out",
    "typecheck": "tsc --noEmit",
    "electron:build": "node scripts/build-electron.mjs && node ../../scripts/audit-private-conversion.mjs --build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "electron:brand-dev": "node scripts/brand-dev-electron.mjs",
    "electron:prepare": "cross-env NEXT_PUBLIC_TARGET=desktop next build && pnpm run electron:build",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:preview": "pnpm run electron:prepare && pnpm run electron:brand-dev && electron .",
    "electron:dist": "pnpm run electron:prepare && electron-builder --config electron-builder.config.cjs --mac --win",
    "electron:dist:mac": "pnpm run electron:prepare && electron-builder --config electron-builder.config.cjs --mac",
    "electron:dist:win": "pnpm run electron:prepare && electron-builder --config electron-builder.config.cjs --win",
    "electron:dist:store": "node scripts/validate-windows-store-env.mjs && pnpm run electron:prepare && cross-env SIGMA_STUDIO_WINDOWS_STORE=true electron-builder --config electron-builder.config.cjs --win appx --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.1.0",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "fs-native-extensions": "1.5.3",
    "i18next": "^27.1.0",
    "jsdom": "^31.0.1",
    "katex": "^0.19.1",
    "lib0": "0.2.120",
    "lowlight": "^3.3.0",
    "mathlive": "^0.111.4",
    "node-tikzjax": "^1.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldts": "^7.5.4",
    "unused-filename": "^4.0.1",
    "ws": "8.23.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@fontsource/m-plus-1p": "^5.2.9",
    "@fontsource/noto-sans-symbols": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@fontsource/stix-two-math": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/utif": "^3.0.6",
    "cross-env": "^10.1.0",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pptx-svg": "^0.6.8",
    "pptx-viewer-core": "^4.14.1",
    "qrcode": "^1.5.4",
    "thinking-orbs": "^0.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "utif": "^3.1.0",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}

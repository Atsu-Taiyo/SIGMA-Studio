{
  "name": "@sigma-studio/desktop",
  "version": "0.504.0",
  "description": "数式と図形を扱う教材エディタ / A teaching-material editor for mathematics and diagrams",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "test:e2e:export": "node scripts/serve-static-export.mjs",
    "perf:build": "node scripts/perf-build.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "perf:probe:noBuild": "node scripts/perf-probe.mjs --no-build",
    "perf:probe:reportOnly": "node scripts/perf-probe.mjs --report-only",
    "csp:smoke": "electron scripts/electron-csp-smoke.mjs out",
    "typecheck": "tsc --noEmit",
    "mcp:sigma-doc": "node scripts/run-sigma-doc-mcp.mjs",
    "electron:build": "node scripts/build-electron.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "electron:brand-dev": "node scripts/brand-dev-electron.mjs",
    "electron:prepare": "cross-env NEXT_PUBLIC_TARGET=desktop next build && npm run electron:build",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:preview": "npm run electron:prepare && npm run electron:brand-dev && electron .",
    "electron:dist": "npm run electron:prepare && electron-builder --config electron-builder.config.cjs --mac --win",
    "electron:dist:mac": "npm run electron:prepare && electron-builder --config electron-builder.config.cjs --mac",
    "electron:dist:win": "npm run electron:prepare && electron-builder --config electron-builder.config.cjs --win",
    "electron:dist:store": "node scripts/validate-windows-store-env.mjs && npm run electron:prepare && cross-env SIGMA_STUDIO_WINDOWS_STORE=true electron-builder --config electron-builder.config.cjs --win appx --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/m-plus-1p": "^5.2.9",
    "@fontsource/noto-sans-symbols": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@napi-rs/canvas": "^1.0.9",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.9.3",
    "fs-native-extensions": "1.5.1",
    "i18next": "^26.4.0",
    "jsdom": "^23.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "lib0": "0.2.119",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.14.0",
    "mathlive": "^0.111.0",
    "next": "^16.3.8",
    "node-tikzjax": "^1.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "pptx-svg": "^0.6.4",
    "pptx-viewer-core": "^4.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "thinking-orbs": "^0.3.1",
    "three": "^0.186.1",
    "tldts": "^7.4.16",
    "unused-filename": "^4.0.1",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.16.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "cross-env": "^10.1.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.8",
    "happy-dom": "^20.11.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}

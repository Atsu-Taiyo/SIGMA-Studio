{
  "name": "sigma-studio-workspace",
  "version": "0.541.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-http-cache-semantics.mjs",
    "dev": "pnpm --filter @sigma-studio/desktop run dev",
    "build": "pnpm --filter @sigma-studio/desktop run build",
    "web:build": "node scripts/build-web.mjs",
    "web:test": "node --test apps/web/worker.test.mjs",
    "ai-gateway:test": "node --test apps/web/ai-gateway/gateway.test.mjs",
    "ai-gateway:check": "pnpm --filter @sigma-studio/web exec wrangler deploy --dry-run --config ai-gateway/wrangler.jsonc",
    "sigma-ai:runtime": "npm ci --prefix apps/desktop/dsh-runtime",
    "web:preview": "pnpm --filter @sigma-studio/web run preview",
    "web:deploy": "pnpm run web:build && pnpm --filter @sigma-studio/web exec wrangler deploy --keep-vars",
    "test:e2e:web": "pnpm --filter @sigma-studio/desktop exec cross-env SIGMA_WEB_E2E=1 SIGMA_STUDIO_E2E_BASE_URL=http://127.0.0.1 playwright test tests/e2e/shared-web.spec.ts",
    "start": "pnpm --filter @sigma-studio/desktop run start",
    "lint": "pnpm --filter @sigma-studio/desktop run lint",
    "test": "pnpm --filter @sigma-studio/desktop run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "audit:private-staged": "node scripts/audit-private-conversion.mjs --staged",
    "audit:private-tracked": "node scripts/audit-private-conversion.mjs --tracked",
    "audit:private-build": "node scripts/audit-private-conversion.mjs --build",
    "test:public-browser": "pnpm --filter @sigma-studio/desktop exec tsc --project ../../tests/public-browser/tsconfig.json && pnpm --filter @sigma-studio/desktop exec playwright test --config ../../tests/public-browser/playwright.config.mts",
    "test:e2e": "pnpm --filter @sigma-studio/desktop run test:e2e",
    "test:e2e:electron": "pnpm --filter @sigma-studio/desktop run test:e2e:electron",
    "typecheck": "pnpm --filter @sigma-studio/desktop run typecheck",
    "viewer:build": "pnpm --filter @sigma-studio/viewer run build",
    "viewer:test": "pnpm --filter @sigma-studio/viewer run test",
    "viewer:typecheck": "pnpm --filter @sigma-studio/viewer run typecheck",
    "viewer:pack": "pnpm --filter @sigma-studio/viewer pack --dry-run",
    "viewer:example": "pnpm --filter @sigma-studio/editor-react19-example run dev",
    "viewer:example:build": "pnpm --filter @sigma-studio/editor-react19-example run build",
    "editor:build": "pnpm run viewer:build && pnpm --filter @sigma-studio/editor run build",
    "editor:test": "pnpm run viewer:build && pnpm --filter @sigma-studio/editor run test",
    "editor:typecheck": "pnpm --filter @sigma-studio/editor run typecheck",
    "editor:pack": "pnpm run editor:build && pnpm --filter @sigma-studio/editor pack --dry-run",
    "editor:example": "pnpm run editor:build && pnpm --filter @sigma-studio/editor-react19-example run dev",
    "editor:example:build": "pnpm run editor:build && pnpm --filter @sigma-studio/editor-react19-example run build",
    "version:set": "node scripts/set-release-version.mjs",
    "version:sync": "node scripts/sync-public-package-versions.mjs",
    "version:check": "node scripts/sync-public-package-versions.mjs --check",
    "public-packages:sync-version": "pnpm run version:sync",
    "public-packages:check-version": "pnpm run version:check",
    "electron:build": "pnpm --filter @sigma-studio/desktop run electron:build",
    "electron:dev": "node apps/desktop/scripts/dev-electron.mjs",
    "electron:preview": "pnpm --filter @sigma-studio/desktop run electron:preview",
    "electron:dist": "pnpm --filter @sigma-studio/desktop run electron:dist",
    "electron:dist:mac": "pnpm --filter @sigma-studio/desktop run electron:dist:mac",
    "electron:dist:win": "pnpm --filter @sigma-studio/desktop run electron:dist:win",
    "electron:dist:store": "pnpm --filter @sigma-studio/desktop run electron:dist:store",
    "collaboration:desktop": "node --env-file=.env.collaboration.local scripts/collaboration-desktop.mjs",
    "collaboration:benchmark": "node scripts/collaboration-benchmark.mjs",
    "dependencies:check": "node scripts/check-desktop-dependencies.mjs",
    "security:audit": "node --test scripts/dependency-security.test.mjs scripts/audit-dependencies.test.mjs && node scripts/audit-dependencies.mjs",
    "test:public-browser:react19": "pnpm run test:public-browser",
    "test:public-browser:react18": "pnpm --filter @sigma-studio/desktop exec playwright test --config ../../tests/public-browser/playwright.react18.config.mts",
    "lockfile:check": "node scripts/check-workspace-lockfile.mjs",
    "lockfile:refresh": "pnpm install --lockfile-only --ignore-scripts && pnpm run lockfile:check"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "typescript-compiler-api": "npm:typescript@5.9.3",
    "js-yaml": "5.5.0",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "@sigma-studio/viewer": "workspace:*"
  },
  "packageManager": "pnpm@11.1.2"
}
